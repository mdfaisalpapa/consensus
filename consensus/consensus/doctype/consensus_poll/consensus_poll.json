    {
      "fieldname": "results_published",
      "fieldtype": "Check",
      "label": "Results Published",
      "read_only": 1
    },
    {
      "fieldname": "results_published_on",
      "fieldtype": "Datetime",
      "label": "Results Published On",
      "read_only": 1
    },
    {
      "fieldname": "snapshot_poll_type_configuration_version",
      "fieldtype": "Data",
      "label": "Poll Type Configuration Version",
      "read_only": 1

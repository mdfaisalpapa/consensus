      "read_only": 1
    },
    {
      "fieldname": "snapshot_rule_config_json",
      "fieldtype": "Code",
      "label": "Canonical Rule Configuration",
      "options": "JSON",
      "read_only": 1
    },
    {
      "fieldname": "snapshot_voter_hmac_key_version",
      "fieldtype": "Data",
      "label": "Voter HMAC Key Version",
      "read_only": 1
    },
    {
      "fieldname": "snapshot_idempotency_hmac_key_version",
      "fieldtype": "Data",
      "label": "Idempotency HMAC Key Version",
      "read_only": 1
    },
    {
      "fieldname": "snapshot_identity_hmac_key_version",
      "fieldtype": "Data",
      "label": "Identity Commitment HMAC Key Version",
      "read_only": 1
    },
    {
      "fieldname": "snapshot_reference_encryption_key_version",
      "fieldtype": "Data",
      "label": "Reference Encryption Key Version",
      "read_only": 1
    },
    {
      "fieldname": "snapshot_identity_encryption_key_version",
      "fieldtype": "Data",
      "label": "Identity Encryption Key Version",
      "read_only": 1
    },
    {
      "fieldname": "snapshot_signing_key_version",
      "fieldtype": "Data",
      "label": "Receipt Signing Key Version",
      "read_only": 1
    },
    {

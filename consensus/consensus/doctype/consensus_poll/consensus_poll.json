{
  "doctype": "DocType",
  "name": "Consensus Poll",
  "module": "Consensus",
  "autoname": "naming_series:",
  "title_field": "title",
  "search_fields": "title,poll_type,status",
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Series",
      "options": "CNS-.#####",
      "default": "CNS-.#####",
      "reqd": 1,
      "hidden": 1
    },
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "Poll Title",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "poll_type",
      "fieldtype": "Link",
      "label": "Poll Type",
      "options": "Consensus Poll Type",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "description",
      "fieldtype": "Text Editor",
      "label": "Description"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Draft\nScheduled\nOpen\nClosed\nCancelled",
      "default": "Draft",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "dates_section",
      "fieldtype": "Section Break",
      "label": "Voting Period"
    },
    {
      "fieldname": "starts_at",
      "fieldtype": "Datetime",
      "label": "Voting Starts",
      "reqd": 1
    },
    {
      "fieldname": "ends_at",
      "fieldtype": "Datetime",
      "label": "Voting Ends",
      "reqd": 1
    },
    {
      "fieldname": "scope_section",
      "fieldtype": "Section Break",
      "label": "Voting Scope"
    },
    {
      "fieldname": "provider_key",
      "fieldtype": "Data",
      "label": "Voter Provider",
      "read_only": 1
    },
    {
      "fieldname": "provider_api_version",
      "fieldtype": "Data",
      "label": "Provider API Version",
      "read_only": 1
    },
    {
      "fieldname": "scope_selections",
      "fieldtype": "Table",
      "label": "Selected Scope Entities",
      "options": "Consensus Poll Scope"
    },
    {
      "fieldname": "scope_selection_operator",
      "fieldtype": "Select",
      "label": "Combine Scope Selections",
      "options": "Any\nAll",
      "default": "Any"
    },
    {
      "fieldname": "scope_conditions",
      "fieldtype": "Code",
      "label": "Provider Scope Conditions",
      "options": "JSON"
    },
    {
      "fieldname": "scope_conditions_operator",
      "fieldtype": "Select",
      "label": "Combine Conditions",
      "options": "All\nAny",
      "default": "All"

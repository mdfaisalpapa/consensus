      "fieldtype": "Section Break",
      "label": "Frozen Snapshot Metadata"
    },
    {
      "fieldname": "snapshot_state",
      "fieldtype": "Select",
      "label": "Snapshot State",
      "options": "Not Started\nBuilding\nComplete\nFailed",
